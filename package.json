{
  "name": "decentralized-voting-system",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Solidity 智能合约与 Ethereum 测试网的去中心化电子投票系统毕业设计项目。",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "cross-env REPORT_GAS=true hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "generate:whitelist": "hardhat run scripts/generateWhitelist.ts",
    "export:frontend": "hardhat run scripts/exportFrontendArtifact.ts",
    "web:dev": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "web:preview": "npm run preview -w apps/web"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@types/node": "^20.11.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.0",
    "hardhat": "^2.22.19",
    "hardhat-gas-reporter": "^2.3.0",
    "keccak256": "^1.0.6",
    "merkletreejs": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  },
  "overrides": {
    "cookie": "0.7.2",
    "ethjs-unit": {
      "bn.js": "4.12.3"
    },
    "lodash": "4.18.1",
    "number-to-bn": {
      "bn.js": "4.12.3"
    },
    "serialize-javascript": "7.0.5",
    "tmp": "0.2.5",
    "undici": "6.25.0"
  }
}
